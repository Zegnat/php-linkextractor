# Run PHPStan and PHP CS Fixer over the library and castor.php.
#
# Each tool has its own manifest in tools/, because the main one has to
# resolve on PHP 7.0 and neither tool installs there.
FROM composer:2.7 AS deps
WORKDIR /app
COPY composer.json ./
COPY vendored ./vendored
COPY tools/phpstan/composer.json ./tools/phpstan/
COPY tools/php-cs-fixer/composer.json ./tools/php-cs-fixer/
RUN composer update --no-interaction --prefer-stable --no-dev --ignore-platform-req=ext-* \
    && composer update --no-interaction --prefer-stable --working-dir=tools/phpstan \
    && composer update --no-interaction --prefer-stable --working-dir=tools/php-cs-fixer

FROM php:8.4-cli
WORKDIR /app
COPY . .
COPY --from=deps /app/vendor ./vendor
COPY --from=deps /app/tools/phpstan/vendor ./tools/phpstan/vendor
COPY --from=deps /app/tools/php-cs-fixer/vendor ./tools/php-cs-fixer/vendor
