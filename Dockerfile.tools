# Run PHPStan and PHP CS Fixer over the library and castor.php.
#
# The tools have their own manifest in tools/, because the main one has to
# resolve on PHP 7.0 and neither tool installs there.
ARG TARGET_PHP=8.4

# Resolve as if running on the target PHP version, as Dockerfile.matrix does.
FROM composer:2.7 AS deps
ARG TARGET_PHP
WORKDIR /app
COPY composer.json ./
COPY vendored ./vendored
COPY tools/composer.json ./tools/
RUN composer config platform.php "${TARGET_PHP}.0" \
    && composer config --working-dir=tools platform.php "${TARGET_PHP}.0" \
    && composer update --no-interaction --prefer-stable --no-dev --ignore-platform-req=ext-* \
    && composer update --no-interaction --prefer-stable --working-dir=tools

FROM php:${TARGET_PHP}-cli
WORKDIR /app
COPY . .
COPY --from=deps /app/vendor ./vendor
COPY --from=deps /app/tools/vendor ./tools/vendor
